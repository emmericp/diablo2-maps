{
  "_doc": [
    "Hand-edited descriptions and in-game screenshots for the tower-room lookup UI.",
    "Path keys reference files under renderer/public/tower-screenshots/. Missing keys",
    "are fine — the UI falls back to atlas-rendered tiles only.",
    "",
    "Schema:",
    "  rooms[<roomId>_<variant>]:",
    "    displayName?  : human name shown next to the tile",
    "    description?  : short blurb (1-2 sentences)",
    "    screenshots[] : list of paths under tower-screenshots/, shown next to the",
    "                    iso tile in the variant picker. Annotate them in-game",
    "                    (circle the diagnostic feature) before saving.",
    "  graves:",
    "    default       : help text + optional screenshot shown for every grave step",
    "    <roomId>_<variant>:  per-room overrides (e.g. an annotated open-vs-closed",
    "                          screenshot specific to the room's slot layout)"
  ],
